# Copy to .env for a real Firebase project; safe to leave unset while
# developing against the local emulator suite (`npm run emulators` at
# the repo root) — firebaseClient.ts falls back to the "demo-serial-bowl"
# project the emulators run under.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "false" once pointing at a real project you want the deployed
# app to talk to directly instead of a local emulator.
VITE_USE_FIREBASE_EMULATORS=true

# Everything defaults to Firestore (the emulator, absent the vars above).
# build:github sets this to "static" so the one real deployed PWA build keeps
# reading the static GitHub Pages library.json until a real project exists.
VITE_LIBRARY_SOURCE=
