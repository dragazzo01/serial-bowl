rules_version = '2';

// Gated on Firebase Auth. A deployed project's client config is not secret,
// so this is the only thing standing between the public internet and
// read/write access to the whole library - every client (Electron main
// process and the browser/PWA) signs in anonymously at startup (see
// firebaseClient.ts's authReady) before touching Firestore, purely so this
// check passes. This is not per-user access control (there's only one user),
// just a gate against anyone who doesn't go through the app at all.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
