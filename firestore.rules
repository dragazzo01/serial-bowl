rules_version = '2';

// Wide open for local emulator prototyping only. Before ever running
// `firebase deploy` against a real project, replace this with rules
// gated on Firebase Auth (e.g. request.auth.uid == OWNER_UID) — a
// deployed project's client config is not secret, so these rules are
// the only thing that would stand between the public internet and
// read/write access to the whole library.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
